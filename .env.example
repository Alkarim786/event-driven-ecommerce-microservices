# Copy to .env to override docker-compose defaults. Never commit .env.
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
# Fallback poll interval for the outbox relay (commits also wake it immediately).
OUTBOX_POLL_INTERVAL=100ms
# Fault injection: probability that the relay publishes an event twice (0 = off).
OUTBOX_CHAOS_DUPLICATE_RATE=0
# Kafka listener threads per service (topics have 3 partitions).
LISTENER_CONCURRENCY=3
