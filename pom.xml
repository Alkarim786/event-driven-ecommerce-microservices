<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.alkarim786.shop</groupId>
  <artifactId>event-driven-ecommerce</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>event-driven-ecommerce-microservices</name>

  <modules>
    <module>events-contract</module>
    <module>messaging-common</module>
    <module>order-service</module>
    <module>inventory-service</module>
    <module>payment-service</module>
    <module>notification-service</module>
    <module>system-tests</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JUnit tag excluded by default; `-Pit` runs the Testcontainers suites. -->
    <excluded.test.groups>integration</excluded.test.groups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.alkarim786.shop</groupId>
        <artifactId>events-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.alkarim786.shop</groupId>
        <artifactId>messaging-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.alkarim786.shop</groupId>
        <artifactId>order-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.alkarim786.shop</groupId>
        <artifactId>inventory-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.alkarim786.shop</groupId>
        <artifactId>payment-service</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.alkarim786.shop</groupId>
        <artifactId>notification-service</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
              <include>**/*IT.java</include>
            </includes>
            <excludedGroups>${excluded.test.groups}</excludedGroups>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <!-- Keep the plain jar so system-tests can depend on the services. -->
            <classifier>exec</classifier>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Windows only: the JDK's NIO selector wake-up pipe uses an AF_UNIX socket in %TEMP%, which
         fails on some machines ("Unable to establish loopback connection"). Point it elsewhere. -->
    <profile>
      <id>windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties>
        <argLine>-Djdk.net.unixdomain.tmpdir=${env.PUBLIC}</argLine>
      </properties>
    </profile>
    <profile>
      <id>it</id>
      <properties>
        <excluded.test.groups>none</excluded.test.groups>
      </properties>
    </profile>
  </profiles>
</project>
